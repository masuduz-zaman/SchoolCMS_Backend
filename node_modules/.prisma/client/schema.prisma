model AdmissionNotice {
  id          String  @id @default(uuid())
  title       String
  content     String
  isPublished Boolean @default(false)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, createdAt])
}

model Class {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  students    Student[]
  subjects    Subject[]
  assignments TeacherClass[]
  routines    ClassRoutine[]

  classTeacherId String?
  classTeacher   Teacher? @relation("ClassTeacher", fields: [classTeacherId], references: [id])

  registrationRequests RegistrationRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classTeacherId])
}

model ClassRoutine {
  id        String @id @default(uuid())
  classId   String
  subjectId String
  teacherId String

  day       WeekDay
  startTime String
  endTime   String
  room      String?

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId, day])
  @@index([teacherId, day])
}

model TeacherClass {
  id        String @id @default(uuid())
  teacherId String
  classId   String

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([teacherId, classId])
  @@index([classId])
}

enum UserRole {
  ADMIN
  STUDENT
  TEACHER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum RequestType {
  STUDENT
  TEACHER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  BLOCKED
}

enum WeekDay {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

model Profile {
  id           String   @id @default(uuid())
  profilePhoto String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  @@map("profiles")
}

model RegistrationRequest {
  id        String  @id @default(uuid())
  name      String
  email     String
  phone     String?
  password  String
  classRoll String?

  requestType RequestType
  status      RequestStatus @default(PENDING)

  classId     String?
  parentPhone String?

  class Class? @relation(fields: [classId], references: [id])

  reviewNote String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([email, status])
  @@index([requestType, status])
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SchoolContent {
  id                 String @id @default(uuid())
  headTeacherMessage String @db.Text

  updatedById String
  updateBy    User   @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id          String  @id @default(uuid())
  userId      String  @unique
  classId     String?
  parentPhone String?

  user User @relation(fields: [userId], references: [id])

  class Class? @relation(fields: [classId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // @@index([classId])
}

model Subject {
  id      String  @id @default(uuid())
  name    String
  classId String?

  class Class? @relation(fields: [classId], references: [id])

  routines ClassRoutine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, name])
}

model Teacher {
  id     String @id @default(uuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id])

  classAssignments      TeacherClass[]
  routines              ClassRoutine[]
  classesAsClassTeacher Class[]        @relation("ClassTeacher")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id       String     @id @default(uuid())
  name     String
  email    String     @unique
  phone    String?
  password String
  role     UserRole   @default(STUDENT)
  status   UserStatus @default(ACTIVE)
  profile  Profile?

  student Student?
  teacher Teacher?

  notices        AdmissionNotice[]
  contentUpdates SchoolContent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

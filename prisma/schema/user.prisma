model User {
  id             String             @id @default(uuid())
  name           String
  email          String             @unique
  phone          String?
  password       String
  role           UserRole           @default(STUDENT)
  status         UserStatus         @default(ACTIVE)
  profile        Profile?

  student        Student?
  teacher        Teacher?

  notices        AdmissionNotice[]
  contentUpdates SchoolContent[]

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}
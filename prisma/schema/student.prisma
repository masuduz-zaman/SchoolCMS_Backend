model Student {
  id          String    @id @default(uuid())
  userId      String    @unique
  classId     String?
  classRoll   String?
  parentPhone String?

  user        User     @relation(fields: [userId], references: [id])

  class       Class?   @relation(fields: [classId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  //          @@index([classId])
}
